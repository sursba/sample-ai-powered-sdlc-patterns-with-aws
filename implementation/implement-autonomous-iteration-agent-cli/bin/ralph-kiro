#!/bin/bash
# ralph-kiro - Ralph Wiggum loop orchestrator for Kiro CLI
# Implements iterative, self-referential AI development loops
#
# Usage: ralph-kiro <command> [OPTIONS]
#
# Based on: https://github.com/ghuntley/how-to-ralph-wiggum

set -euo pipefail

# Version
VERSION="2.0.0"

# Stall detection
STALL_THRESHOLD=3  # Stop if no commits for N consecutive iterations

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

# Default values
MAX_ITERATIONS=50
COMPLETION_PROMISE="DONE"
AGENT="ralph"
PROMPT=""
STATE_FILE=".kiro/ralph-state.json"
DELAY_SECONDS=2
VERBOSE=false
AWS_PROFILE=""
NO_BRANCH=false
MAX_COST=""

# Check for updates (runs in background, non-blocking)
check_for_updates() {
    local install_dir="$HOME/RalphKiro"
    
    # Only check if installed via git clone
    if [[ ! -d "$install_dir/.git" ]]; then
        return
    fi
    
    # Check at most once per day
    local last_check_file="$install_dir/.last_update_check"
    local now=$(date +%s)
    
    if [[ -f "$last_check_file" ]]; then
        local last_check=$(cat "$last_check_file")
        local diff=$((now - last_check))
        # 86400 seconds = 24 hours
        if [[ $diff -lt 86400 ]]; then
            return
        fi
    fi
    
    # Update timestamp
    echo "$now" > "$last_check_file" 2>/dev/null || true
    
    # Fetch latest (silently, in background)
    (
        cd "$install_dir"
        git fetch origin master --quiet 2>/dev/null || git fetch origin main --quiet 2>/dev/null || true
        
        local local_commit=$(git rev-parse HEAD 2>/dev/null)
        local remote_commit=$(git rev-parse origin/master 2>/dev/null || git rev-parse origin/main 2>/dev/null)
        
        if [[ -n "$local_commit" && -n "$remote_commit" && "$local_commit" != "$remote_commit" ]]; then
            # Write update available flag
            echo "$remote_commit" > "$install_dir/.update_available" 2>/dev/null || true
        else
            rm -f "$install_dir/.update_available" 2>/dev/null || true
        fi
    ) &
}

# Show update notice if available
show_update_notice() {
    local install_dir="$HOME/RalphKiro"
    local update_file="$install_dir/.update_available"
    
    if [[ -f "$update_file" ]]; then
        echo -e "${YELLOW}📦 Update available!${NC} Run: ${CYAN}cd ~/RalphKiro && git pull${NC}"
        echo ""
    fi
}

# Telemetry - disabled in public version
TELEMETRY_ENDPOINT=""
TELEMETRY_ENABLED=false

send_metric() {
    # Telemetry not available in public version
    return
}

usage() {
    echo -e "${CYAN}Ralph Wiggum Loop for Kiro CLI${NC} ${BLUE}v${VERSION}${NC}

Autonomous AI development loops. Give it a task, it iterates until done.
Named after Ralph Wiggum - cheerfully charges forward with unwavering optimism.

${YELLOW}Usage:${NC}
  ralph-kiro <command> [OPTIONS]

${YELLOW}Commands:${NC}
  init \"PROMPT\"           Start a new Ralph loop with the given prompt
  plan \"DESCRIPTION\"      Generate a prd.json from a natural language description
  iterate                 Continue iterating on an existing loop
  review                  Run a judge pass - evaluate progress without making changes
  status                  Show current loop status
  reset                   Clear state and start fresh
  setup                   Install ralph agent to ~/.kiro/agents/

${YELLOW}Options:${NC}
  --max-iterations N      Stop after N iterations (default: 50)
  --max N                 Shorthand for --max-iterations
  --aws-profile PROFILE   AWS profile for build/deploy (default: default)
  --completion-promise S  Phrase that signals completion (default: DONE)
  --agent NAME            Custom agent to use (default: ralph)
  --delay SECONDS         Delay between iterations (default: 2)
  --no-branch             Skip auto-creating a feature branch on init
  --max-cost DOLLARS      Stop loop when estimated cost exceeds this amount
  --verbose               Show detailed output
  --help                  Show this help message

${YELLOW}Quick Start (Simple Prompt):${NC}
  ralph-kiro init \"Build a todo app with React and local storage\"
  ralph-kiro iterate

${YELLOW}Quick Start (PRD File):${NC}
  # Create prd.json with structured requirements, then:
  ralph-kiro init \"Build the app described in prd.json\" --aws-profile dev
  ralph-kiro iterate

${YELLOW}Commands in Action:${NC}
  ralph-kiro setup                        # First time: install agent
  ralph-kiro init \"Your task\" --aws-profile dev  # Start new loop
  ralph-kiro iterate                      # Continue working
  ralph-kiro iterate --max 10             # Run up to 10 iterations
  ralph-kiro status                       # Check progress
  ralph-kiro reset                        # Start fresh

${YELLOW}Sample PRDs:${NC}
  ~/RalphKiro/src/lib/sample-prds/
  - serverless-hello-api.json   (5-8 iterations, deploys to AWS)
  - todo-app.json               (10-15 iterations, React frontend)
  - analytics-dashboard.json    (30-50 iterations, full-stack serverless)

${YELLOW}PRD Format Example:${NC}
  {
    \"name\": \"My Project\",
    \"description\": \"What you're building\",
    \"requirements\": [
      {\"id\": \"1\", \"category\": \"Setup\", \"tasks\": [\"Task 1\", \"Task 2\"]},
      {\"id\": \"2\", \"category\": \"Feature\", \"tasks\": [\"Task 3\", \"Task 4\"]}
    ],
    \"success_criteria\": [\"Tests pass\", \"Deploys successfully\"]
  }

${YELLOW}Tips:${NC}
  - Use prd.json for complex projects with multiple requirements
  - Simple prompts work great for quick tasks
  - AWS profile persists across iterations (set once with init)
  - Check progress.txt to see what Ralph has done
"
}

# Get the package lib directory (where agent.json lives)
get_package_lib_dir() {
    local script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    local lib_dir="$(dirname "$script_dir")/lib"
    
    if [[ -d "$lib_dir/agents" ]]; then
        echo "$lib_dir"
        return
    fi
    
    local brazil_lib="${script_dir}/../private/lib"
    if [[ -d "$brazil_lib/agents" ]]; then
        echo "$brazil_lib"
        return
    fi
    
    echo "$script_dir/../lib"
}

cmd_setup() {
    local lib_dir="$(get_package_lib_dir)"
    local agent_src="$lib_dir/agents/ralph.json"
    local agent_dest="$HOME/.kiro/agents/ralph.json"
    
    if [[ ! -f "$agent_src" ]]; then
        echo -e "${RED}Error: Agent file not found at $agent_src${NC}"
        echo "Package may not be installed correctly."
        exit 1
    fi
    
    mkdir -p "$HOME/.kiro/agents"
    cp "$agent_src" "$agent_dest"
    
    echo -e "${GREEN}✓ Ralph agent installed to $agent_dest${NC}"
    echo ""
    echo "You can now run: ralph-kiro init \"Your task here\""
}

cmd_plan() {
    if [[ -z "$PROMPT" ]]; then
        echo -e "${RED}Error: Description is required${NC}"
        echo "Usage: ralph-kiro plan \"I want a serverless API that...\""
        exit 1
    fi

    # Check if agent is installed
    if [[ ! -f "$HOME/.kiro/agents/ralph.json" ]]; then
        echo -e "${YELLOW}Ralph agent not found. Running setup...${NC}"
        cmd_setup
        echo ""
    fi

    echo -e "${CYAN}📋 Generating PRD from description...${NC}"
    echo ""

    local plan_prompt="Generate a structured prd.json file from this description. Output ONLY the JSON file content, no explanation.

Description: $PROMPT

The prd.json should follow this format:
{
  \"name\": \"Project Name\",
  \"description\": \"What the project does\",
  \"requirements\": [
    {\"id\": \"1\", \"category\": \"Setup\", \"tasks\": [\"task1\", \"task2\"], \"priority\": \"high\"},
    {\"id\": \"2\", \"category\": \"Core\", \"tasks\": [\"task3\"], \"priority\": \"high\"},
    {\"id\": \"3\", \"category\": \"Features\", \"tasks\": [\"task4\"], \"priority\": \"medium\"}
  ],
  \"success_criteria\": [\"criterion 1\", \"criterion 2\"],
  \"tech_stack\": [\"technology choices\"]
}

Write the JSON to prd.json in the current directory."

    kiro-cli chat --agent "$AGENT" --no-interactive --trust-all-tools "$plan_prompt" 2>&1 || true

    if [[ -f "prd.json" ]]; then
        echo ""
        echo -e "${GREEN}✓ PRD generated: prd.json${NC}"
        echo ""
        echo "Review it, then run:"
        echo -e "  ${CYAN}ralph-kiro init \"Build the application described in prd.json\"${NC}"
    else
        echo -e "${YELLOW}PRD file was not created. Check the output above.${NC}"
    fi
}

cmd_review() {
    if [[ ! -f "$STATE_FILE" ]]; then
        echo -e "${RED}Error: No Ralph loop found${NC}"
        echo "Start one with: ralph-kiro init \"Your task\""
        exit 1
    fi

    local prompt=$(jq -r '.prompt' "$STATE_FILE")

    echo -e "${CYAN}🔍 Running judge review...${NC}"
    echo ""

    local review_prompt="You are a JUDGE reviewing the current state of this project. Do NOT make any changes.

ORIGINAL REQUIREMENTS:
$prompt

YOUR TASK:
1. Read progress.txt to see what has been completed
2. Read prd.json or prd.md if they exist to see the full requirements
3. Review the codebase to assess current state
4. Compare against the original requirements and success criteria

OUTPUT A REPORT:
- Requirements met (list each with ✅ or ❌)
- Code quality assessment (tests passing, lint clean, types clean)
- Estimated completion percentage
- Remaining work summary
- Risks or blockers

Do NOT modify any files. This is a read-only review."

    kiro-cli chat --agent "$AGENT" --no-interactive --trust-all-tools "$review_prompt" 2>&1 || true
}

cmd_status() {
    if [[ ! -f "$STATE_FILE" ]]; then
        echo -e "${YELLOW}No active Ralph loop${NC}"
        echo "Start one with: ralph-kiro init \"Your task\""
        exit 0
    fi
    
    echo -e "${CYAN}Ralph Loop Status${NC}"
    echo "─────────────────────────────────"
    
    local active=$(jq -r '.active' "$STATE_FILE")
    local iteration=$(jq -r '.iteration' "$STATE_FILE")
    local max=$(jq -r '.maxIterations' "$STATE_FILE")
    local promise=$(jq -r '.completionPromise' "$STATE_FILE")
    local started=$(jq -r '.startedAt' "$STATE_FILE")
    local aws_profile=$(jq -r '.awsProfile // "default"' "$STATE_FILE")
    
    if [[ "$active" == "true" ]]; then
        echo -e "Status:      ${GREEN}Active${NC}"
    else
        local success=$(jq -r '.success // false' "$STATE_FILE")
        if [[ "$success" == "true" ]]; then
            echo -e "Status:      ${GREEN}Completed${NC}"
        else
            echo -e "Status:      ${YELLOW}Stopped${NC}"
        fi
    fi
    
    echo "Iteration:   $iteration / $max"
    echo "AWS Profile: $aws_profile"
    echo "Promise:     $promise"
    echo "Started:     $started"
    echo ""
    echo -e "${BLUE}Prompt:${NC}"
    jq -r '.prompt' "$STATE_FILE" | head -10
    
    if [[ "$active" == "true" ]]; then
        echo ""
        echo -e "Continue with: ${CYAN}ralph-kiro iterate${NC}"
    fi
}

cmd_reset() {
    if [[ -f "$STATE_FILE" ]]; then
        rm "$STATE_FILE"
        echo -e "${GREEN}✓ Ralph state cleared${NC}"
    else
        echo -e "${YELLOW}No state to clear${NC}"
    fi
    echo "Start fresh with: ralph-kiro init \"Your task\""
}

cmd_init() {
    # Check if agent is installed
    if [[ ! -f "$HOME/.kiro/agents/ralph.json" ]]; then
        echo -e "${YELLOW}Ralph agent not found. Running setup...${NC}"
        cmd_setup
        echo ""
    fi

    if [[ -z "$PROMPT" ]]; then
        echo -e "${RED}Error: Prompt is required${NC}"
        echo "Usage: ralph-kiro init \"Your task description\""
        exit 1
    fi

    # Check for existing active loop
    if [[ -f "$STATE_FILE" ]]; then
        local active=$(jq -r '.active' "$STATE_FILE" 2>/dev/null || echo "false")
        if [[ "$active" == "true" ]]; then
            echo -e "${YELLOW}Warning: An active Ralph loop already exists${NC}"
            echo "Use 'ralph-kiro iterate' to continue, or 'ralph-kiro reset' to start fresh"
            exit 1
        fi
    fi

    # Ensure .kiro directory exists
    mkdir -p .kiro

    # Use provided AWS profile or default
    local profile="${AWS_PROFILE:-default}"

    # Auto-create feature branch unless --no-branch
    local branch_name=""
    if [[ "$NO_BRANCH" == "false" ]] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        branch_name="ralph/$(date +%Y%m%d-%H%M%S)"
        git checkout -b "$branch_name" 2>/dev/null && \
            echo -e "${GREEN}✓ Created branch: $branch_name${NC}" || \
            echo -e "${YELLOW}⚠ Could not create branch, continuing on current branch${NC}"
    fi

    # Initialize AGENTS.md if it doesn't exist
    if [[ ! -f "AGENTS.md" ]]; then
        cat > "AGENTS.md" << 'AGENTSEOF'
# AGENTS.md - Project Knowledge Base

This file accumulates patterns, conventions, and learnings across Ralph iterations.
The agent reads this at the start of each iteration to avoid repeating mistakes.

## Patterns & Conventions
<!-- Add project patterns here -->

## Gotchas
<!-- Add things that tripped up the agent -->

## Recent Learnings
<!-- Agent appends learnings here after each iteration -->
AGENTSEOF
        echo -e "${GREEN}✓ Created AGENTS.md knowledge base${NC}"
    fi

    # Initialize state file
    cat > "$STATE_FILE" << EOF
{
  "active": true,
  "iteration": 0,
  "maxIterations": $MAX_ITERATIONS,
  "completionPromise": "$COMPLETION_PROMISE",
  "awsProfile": "$profile",
  "branch": "$branch_name",
  "maxCost": "${MAX_COST:-}",
  "prompt": $(echo "$PROMPT" | jq -Rs .),
  "startedAt": "$(date -u +%Y-%m-%dT%H:%M:%SZ)",
  "agent": "$AGENT",
  "metrics": {
    "totalIterations": 0,
    "estimatedCostUsd": 0,
    "stalls": 0
  }
}
EOF

    echo -e "${GREEN}✓ Ralph loop initialized${NC}"
    echo ""
    echo -e "  ${BLUE}Prompt:${NC}      $(echo "$PROMPT" | head -c 60)..."
    echo -e "  ${BLUE}AWS Profile:${NC} $profile"
    echo -e "  ${BLUE}Max Iter:${NC}    $MAX_ITERATIONS"
    echo ""
    echo -e "Run ${CYAN}ralph-kiro iterate${NC} to start working"
    
    # Send telemetry
    local prompt_length=${#PROMPT}
    send_metric "loop_init" "{\"max_iterations\":$MAX_ITERATIONS,\"aws_profile\":\"$profile\",\"prompt_length\":$prompt_length}"
}

run_iteration() {
    local iteration=$1
    local max_iterations=$2
    local prompt=$3
    local aws_profile=$4
    
    # Update state
    jq ".iteration = $iteration" "$STATE_FILE" > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    
    # Capture git commit count before iteration (for stall detection)
    local commits_before=0
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        commits_before=$(git rev-list --count HEAD 2>/dev/null || echo 0)
    fi
    
    local start_time=$(jq -r '.startedAt' "$STATE_FILE")
    
    echo -e "${CYAN}🔄 Ralph Iteration $iteration / $max_iterations${NC}"
    echo ""
    
    # Build AGENTS.md context injection
    local agents_context=""
    if [[ -f "AGENTS.md" ]]; then
        agents_context="

PROJECT KNOWLEDGE BASE (AGENTS.md):
$(cat AGENTS.md)
"
    fi

    # Build recent git context for resume
    local git_context=""
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        local recent_commits=$(git -P log --oneline -5 2>/dev/null || echo "No commits yet")
        git_context="

RECENT GIT HISTORY (last 5 commits):
$recent_commits
"
    fi

    # Build iteration prompt with context
    local iter_prompt="[Ralph Loop - Iteration $iteration of $max_iterations]

$prompt

---
RALPH METHODOLOGY:
1. READ progress.txt (if exists) to see what's already done - don't re-explore
2. READ AGENTS.md (if exists) for project patterns, conventions, and gotchas
3. CHOOSE the highest priority task (risky/architectural first, easy wins last)
4. TAKE SMALL STEPS - one logical change per commit
5. RUN FEEDBACK LOOPS before committing (tests, types, lint must pass)
6. COMMIT after each completed task with clear message
7. APPEND to progress.txt: task done, decisions made, files changed
8. APPEND to AGENTS.md: any new patterns, gotchas, or learnings discovered
9. Output <promise>$COMPLETION_PROMISE</promise> ONLY when ALL tasks genuinely complete

PRIORITIZATION ORDER:
- Architectural decisions and core abstractions (HIGH)
- Integration points between modules (HIGH)  
- Unknown unknowns and spike work (HIGH)
- Standard features and implementation (MEDIUM)
- Polish, cleanup, and quick wins (LOW)

ITERATION CONTEXT:
- This is iteration $iteration of $max_iterations
- Previous work persists in files, git history, and progress.txt
- Quality over speed - small steps compound into big progress
- AWS_PROFILE is set to '$aws_profile' - use this for any AWS CLI/SDK operations
${agents_context}${git_context}"

    # Export AWS profile
    export AWS_PROFILE="$aws_profile"

    # Run kiro-cli and capture output
    local output_file=$(mktemp)
    local iter_start=$(date +%s)
    
    if $VERBOSE; then
        kiro-cli chat --agent "$AGENT" --no-interactive --trust-all-tools "$iter_prompt" 2>&1 | tee "$output_file" || true
    else
        kiro-cli chat --agent "$AGENT" --no-interactive --trust-all-tools "$iter_prompt" 2>&1 | tee "$output_file" || true
    fi
    
    local output=$(cat "$output_file")
    rm -f "$output_file"
    
    local iter_end=$(date +%s)
    local iter_duration=$((iter_end - iter_start))
    
    # Estimate cost (~$0.05 per iteration as rough baseline)
    local iter_cost="0.05"
    local total_cost=$(jq -r '.metrics.estimatedCostUsd // 0' "$STATE_FILE")
    total_cost=$(echo "$total_cost + $iter_cost" | bc 2>/dev/null || echo "$total_cost")
    
    # Update metrics in state
    jq ".metrics.totalIterations = $iteration | .metrics.estimatedCostUsd = $total_cost" "$STATE_FILE" > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    
    # Check cost limit
    if [[ -n "$MAX_COST" ]]; then
        local over=$(echo "$total_cost >= $MAX_COST" | bc 2>/dev/null || echo "0")
        if [[ "$over" == "1" ]]; then
            echo ""
            echo -e "${YELLOW}💰 Cost limit reached (\$$total_cost >= \$$MAX_COST). Stopping loop.${NC}"
            return 2  # Special code for cost limit
        fi
    fi
    
    # Stall detection - check if any new commits were made
    local commits_after=0
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        commits_after=$(git rev-list --count HEAD 2>/dev/null || echo 0)
    fi
    
    if [[ "$commits_after" -le "$commits_before" ]]; then
        local stalls=$(jq -r '.metrics.stalls // 0' "$STATE_FILE")
        stalls=$((stalls + 1))
        jq ".metrics.stalls = $stalls" "$STATE_FILE" > "${STATE_FILE}.tmp"
        mv "${STATE_FILE}.tmp" "$STATE_FILE"
        
        if [[ $stalls -ge $STALL_THRESHOLD ]]; then
            echo ""
            echo -e "${YELLOW}⚠️  Stall detected: No new commits for $stalls consecutive iterations. Stopping.${NC}"
            echo "The agent may be stuck. Review progress.txt and AGENTS.md, then try:"
            echo "  ralph-kiro review    # See what's blocking"
            echo "  ralph-kiro iterate   # Try again"
            return 2
        else
            echo -e "${YELLOW}⚠️  No new commits this iteration ($stalls/$STALL_THRESHOLD before auto-stop)${NC}"
        fi
    else
        # Reset stall counter on successful commit
        jq '.metrics.stalls = 0' "$STATE_FILE" > "${STATE_FILE}.tmp"
        mv "${STATE_FILE}.tmp" "$STATE_FILE"
    fi
    
    echo ""
    echo "─────────────────────────────────────────────────────────────────"
    
    # Check for completion promise
    if echo "$output" | grep -qE "<promise>$COMPLETION_PROMISE</promise>"; then
        # Send telemetry - iteration completed with promise
        send_metric "iteration" "{\"iteration\":$iteration,\"max_iterations\":$max_iterations,\"completed\":true,\"duration\":$iter_duration}"
        return 0  # Completed
    fi
    
    # Send telemetry - iteration completed without promise
    send_metric "iteration" "{\"iteration\":$iteration,\"max_iterations\":$max_iterations,\"completed\":false,\"duration\":$iter_duration}"
    return 1  # Not completed
}

cmd_iterate() {
    if [[ ! -f "$STATE_FILE" ]]; then
        echo -e "${RED}Error: No Ralph loop found${NC}"
        echo "Start one with: ralph-kiro init \"Your task\""
        exit 1
    fi
    
    # Load state
    local prompt=$(jq -r '.prompt' "$STATE_FILE")
    local current_iteration=$(jq -r '.iteration' "$STATE_FILE")
    local stored_max=$(jq -r '.maxIterations' "$STATE_FILE")
    local aws_profile=$(jq -r '.awsProfile // "default"' "$STATE_FILE")
    local completion_promise=$(jq -r '.completionPromise' "$STATE_FILE")
    AGENT=$(jq -r '.agent // "ralph"' "$STATE_FILE")
    COMPLETION_PROMISE="$completion_promise"
    
    # Use command-line max if provided, otherwise use stored value
    local max_iterations=${MAX_ITERATIONS:-$stored_max}
    if [[ "$MAX_ITERATIONS" == "50" && "$stored_max" != "50" ]]; then
        max_iterations=$stored_max
    fi
    
    # Mark as active
    jq '.active = true' "$STATE_FILE" > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    
    echo -e "${CYAN}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${CYAN}║${NC}           ${YELLOW}🔄 Ralph Wiggum Loop Continuing${NC}                  ${CYAN}║${NC}"
    echo -e "${CYAN}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${BLUE}AWS Profile:${NC}        $aws_profile"
    echo -e "  ${BLUE}Current Iteration:${NC}  $current_iteration"
    echo -e "  ${BLUE}Max Iterations:${NC}     $max_iterations"
    echo -e "  ${BLUE}Completion Promise:${NC} $COMPLETION_PROMISE"
    echo ""
    echo "─────────────────────────────────────────────────────────────────"
    echo ""
    
    local iteration=$current_iteration
    local start_time=$(date +%s)
    
    while [[ $iteration -lt $max_iterations ]]; do
        iteration=$((iteration + 1))
        
        local result=0
        run_iteration "$iteration" "$max_iterations" "$prompt" "$aws_profile" || result=$?
        
        if [[ $result -eq 0 ]]; then
            # Completed!
            local elapsed=$(($(date +%s) - start_time))
            local elapsed_min=$((elapsed / 60))
            local elapsed_sec=$((elapsed % 60))
            local total_cost=$(jq -r '.metrics.estimatedCostUsd // 0' "$STATE_FILE")
            
            echo ""
            echo -e "${GREEN}╔════════════════════════════════════════════════════════════╗${NC}"
            echo -e "${GREEN}║${NC}        ${GREEN}✅ Ralph Loop Complete!${NC}                            ${GREEN}║${NC}"
            echo -e "${GREEN}╚════════════════════════════════════════════════════════════╝${NC}"
            echo ""
            echo -e "  ${BLUE}Iterations:${NC}  $iteration"
            echo -e "  ${BLUE}Duration:${NC}    ${elapsed_min}m ${elapsed_sec}s"
            echo -e "  ${BLUE}Est. Cost:${NC}   \$${total_cost}"
            echo ""
            
            jq '.active = false | .completedAt = "'"$(date -u +%Y-%m-%dT%H:%M:%SZ)"'" | .success = true' "$STATE_FILE" > "${STATE_FILE}.tmp"
            mv "${STATE_FILE}.tmp" "$STATE_FILE"
            
            # Send telemetry - loop completed successfully
            send_metric "loop_complete" "{\"iterations\":$iteration,\"duration_seconds\":$elapsed,\"success\":true,\"reason\":\"completed\",\"cost\":$total_cost}"
            
            exit 0
        elif [[ $result -eq 2 ]]; then
            # Stall or cost limit - stop gracefully
            local elapsed=$(($(date +%s) - start_time))
            local total_cost=$(jq -r '.metrics.estimatedCostUsd // 0' "$STATE_FILE")
            
            jq '.active = false | .iteration = '"$iteration"'' "$STATE_FILE" > "${STATE_FILE}.tmp"
            mv "${STATE_FILE}.tmp" "$STATE_FILE"
            
            send_metric "loop_complete" "{\"iterations\":$iteration,\"duration_seconds\":$elapsed,\"success\":false,\"reason\":\"stall_or_cost\",\"cost\":$total_cost}"
            exit 1
        fi
        
        if [[ $iteration -lt $max_iterations ]]; then
            echo -e "${YELLOW}Continuing to next iteration in ${DELAY_SECONDS}s...${NC}"
            sleep "$DELAY_SECONDS"
            echo ""
        fi
    done
    
    # Max iterations reached
    local elapsed=$(($(date +%s) - start_time))
    local elapsed_min=$((elapsed / 60))
    local elapsed_sec=$((elapsed % 60))
    local total_cost=$(jq -r '.metrics.estimatedCostUsd // 0' "$STATE_FILE")
    
    echo ""
    echo -e "${YELLOW}╔════════════════════════════════════════════════════════════╗${NC}"
    echo -e "${YELLOW}║${NC}        ${YELLOW}⏸️  Iteration Limit Reached${NC}                         ${YELLOW}║${NC}"
    echo -e "${YELLOW}╚════════════════════════════════════════════════════════════╝${NC}"
    echo ""
    echo -e "  ${BLUE}Iterations:${NC}  $iteration"
    echo -e "  ${BLUE}Duration:${NC}    ${elapsed_min}m ${elapsed_sec}s"
    echo -e "  ${BLUE}Est. Cost:${NC}   \$${total_cost}"
    echo ""
    echo "Continue with: ralph-kiro iterate"
    echo "Or increase limit: ralph-kiro iterate --max 100"
    echo ""
    
    jq '.active = false | .iteration = '"$iteration"'' "$STATE_FILE" > "${STATE_FILE}.tmp"
    mv "${STATE_FILE}.tmp" "$STATE_FILE"
    
    # Send telemetry - loop stopped at max iterations
    send_metric "loop_complete" "{\"iterations\":$iteration,\"duration_seconds\":$elapsed,\"success\":false,\"reason\":\"max_iterations\"}"
}

# Run update check in background (non-blocking)
check_for_updates

# Parse command
COMMAND=""
if [[ $# -gt 0 ]]; then
    case $1 in
        init|iterate|status|reset|setup|plan|review|--help|-h|help)
            COMMAND="$1"
            shift
            ;;
        --version|-v)
            echo "ralph-kiro v${VERSION}"
            exit 0
            ;;
        --*)
            # Old style: ralph-kiro --option "prompt"
            # Treat as init for backwards compatibility
            COMMAND="init"
            ;;
        *)
            # Assume it's a prompt for init (backwards compatibility)
            COMMAND="init"
            PROMPT="$1"
            shift
            ;;
    esac
fi

# Show update notice for interactive commands
case "${COMMAND:-help}" in
    status|--help|-h|help|"")
        show_update_notice
        ;;
esac

# Parse remaining arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        --max-iterations|--max)
            MAX_ITERATIONS="$2"
            shift 2
            ;;
        --completion-promise)
            COMPLETION_PROMISE="$2"
            shift 2
            ;;
        --agent)
            AGENT="$2"
            shift 2
            ;;
        --delay)
            DELAY_SECONDS="$2"
            shift 2
            ;;
        --aws-profile)
            AWS_PROFILE="$2"
            shift 2
            ;;
        --no-branch)
            NO_BRANCH=true
            shift
            ;;
        --max-cost)
            MAX_COST="$2"
            shift 2
            ;;
        --verbose)
            VERBOSE=true
            shift
            ;;
        --help|-h)
            usage
            exit 0
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            usage
            exit 1
            ;;
        *)
            if [[ -z "$PROMPT" ]]; then
                PROMPT="$1"
            fi
            shift
            ;;
    esac
done

# Execute command
case $COMMAND in
    init)
        cmd_init
        ;;
    plan)
        cmd_plan
        ;;
    iterate)
        cmd_iterate
        ;;
    review)
        cmd_review
        ;;
    status)
        cmd_status
        ;;
    reset)
        cmd_reset
        ;;
    setup)
        cmd_setup
        ;;
    --help|-h|help|"")
        usage
        exit 0
        ;;
    *)
        echo -e "${RED}Unknown command: $COMMAND${NC}"
        usage
        exit 1
        ;;
esac
